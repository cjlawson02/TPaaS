{
  "name": "tpaas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "Trolley Problem as a Service — random meme API on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "node scripts/wrangler-types.mjs",
    "types:check": "node scripts/wrangler-types.mjs --check",
    "test": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "r2:cors": "wrangler r2 bucket cors set tpaas-assets --file r2-cors/tpaas-assets.json -y"
  },
  "dependencies": {
    "discord-interactions": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.7",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.93.0"
  }
}
